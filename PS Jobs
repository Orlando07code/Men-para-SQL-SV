<#
.SYNOPSIS
    Script de prueba local para actualizar estatus de jobs en Excel.
#>

Stop-Process -Name "EXCEL" -Force -ErrorAction SilentlyContinue

# --- CONFIGURACIÓN ---
$ServerInstance = "10.10.50.31"
$CredPath = "C:\Users\practicas1\Documents\PruebaLocal\MantenimientoDemo\sql_cred.dat"

if (!(Test-Path $CredPath)) {
    Write-Host "[ERROR] No se encontró el archivo de credenciales: $CredPath" -ForegroundColor Red
    exit
}

$secure = Get-Content -Path $CredPath | ConvertTo-SecureString
$json   = [System.Net.NetworkCredential]::new("", $secure).Password
$Cred   = $json | ConvertFrom-Json


$ExcelPath      = "C:\Users\practicas1\Documents\PruebaLocal\MantenimientoDemo\Mantenimientos de Base de datosDemo.xlsx"
$SheetName      = "Octubre Demo"
$TempExcelPath  = "$env:TEMP\Mantenimiento_Temp.xlsx"

if (Test-Path $TempExcelPath) {
    Remove-Item -Path $TempExcelPath -Force -ErrorAction SilentlyContinue
}

Write-Host "[INFO] Preparando archivo local..." -ForegroundColor Cyan
if (!(Test-Path $ExcelPath)) {
    Write-Host "[ERROR] No se encontró el archivo en: $ExcelPath" -ForegroundColor Red
    exit
}

Copy-Item -Path $ExcelPath -Destination $TempExcelPath -Force
Set-ItemProperty -Path $TempExcelPath -Name IsReadOnly -Value $false

Write-Host "[INFO] Conectando a SQL Server..." -ForegroundColor Cyan

try {
    $Builder = New-Object System.Data.SqlClient.SqlConnectionStringBuilder
    $Builder["Data Source"]            = $ServerInstance
    $Builder["Initial Catalog"]        = "msdb"
$Builder["User ID"]  = $Cred.User
$Builder["Password"] = $Cred.Password
    $Builder["TrustServerCertificate"] = $true

    $Connection = New-Object System.Data.SqlClient.SqlConnection($Builder.ConnectionString)
    $Connection.Open()
    
    $Query = "EXEC msdb.dbo.ObtenerEstatusJobs_Alias_Orlando"
    $Command = $Connection.CreateCommand()
    $Command.CommandText = $Query
    
    $Adapter = New-Object System.Data.SqlClient.SqlDataAdapter($Command)
    $Dataset = New-Object System.Data.DataSet
    [void]$Adapter.Fill($Dataset)
    
    $SqlData = $Dataset.Tables[0]
    $Connection.Close()
}
catch {
    Write-Host "[ERROR] Error en SQL: $_" -ForegroundColor Red
    exit
}

if (!$SqlData -or $SqlData.Rows.Count -eq 0) {
    Write-Host "[ADVERTENCIA] El SP no devolvió registros." -ForegroundColor Yellow
    exit
}

Write-Host "[INFO] Actualizando Excel..." -ForegroundColor Cyan
$ExcelApp = New-Object -ComObject Excel.Application
$ExcelApp.Visible = $false
$ExcelApp.DisplayAlerts = $false
$Actualizados = 0

try {
    $Workbook = $ExcelApp.Workbooks.Open($TempExcelPath)
    $Worksheet = $Workbook.Sheets.Item($SheetName)

    $UsedRange = $Worksheet.UsedRange
    $RowsCount = $UsedRange.Rows.Count
    $ColsCount = $UsedRange.Columns.Count

    foreach ($Registro in $SqlData) {
        $JobName = [string]$Registro.NombreJob
        $Dia     = [string]$Registro.Dia
        $Estatus = [string]$Registro.Estatus

        for ($r = 1; $r -le $RowsCount; $r++) {
            $foundRow = $false
            for ($c = 1; $c -le 3; $c++) {
                $cellVal = [string]$Worksheet.Cells.Item($r, $c).Value2
                if ($cellVal -eq $JobName) {
                    $foundRow = $true
                    break
                }
            }

            if ($foundRow) {
                for ($col = 1; $col -le $ColsCount; $col++) {
                    $headerVal = $Worksheet.Cells.Item(1, $col).Value2
                    if ($null -eq $headerVal) { continue }

                    $headerStr = ""
                    if ($headerVal -is [double] -or $headerVal -is [int]) {
                        $headerStr = [DateTime]::FromOADate($headerVal).ToString("d/M/yyyy")
                    } else {
                        $headerStr = [string]$headerVal
                    }

                    $headerDay = $headerStr.Split('/')[0].Trim()

                    if ($headerDay -eq $Dia.Trim()) {
                        $currentVal = [string]$Worksheet.Cells.Item($r, $col).Value2
                        if ([string]::IsNullOrWhiteSpace($currentVal)) {
                            $Worksheet.Cells.Item($r, $col).Value2 = $Estatus
                            Write-Host "  -> [RELLENADO] Job '$JobName' | Día $Dia -> $Estatus" -ForegroundColor Green
                            $Actualizados++
                        }
                        break
                    }
                }
                break
            }
        }
    }

    $Workbook.Save()
    $Workbook.Close($true)
    $ExcelApp.Quit()
    [System.Runtime.Interopservices.Marshal]::ReleaseComObject($ExcelApp) | Out-Null
}
catch {
    Write-Host "[ERROR] Error COM: $_" -ForegroundColor Red
    $ExcelApp.Quit()
    [System.Runtime.Interopservices.Marshal]::ReleaseComObject($ExcelApp) | Out-Null
    exit
}

Copy-Item -Path $TempExcelPath -Destination $ExcelPath -Force
Write-Host "[EXITO] Prueba local finalizada. Celdas actualizadas: $Actualizados" -ForegroundColor Cyan
